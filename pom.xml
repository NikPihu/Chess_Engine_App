<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.nikpihu</groupId>
  <artifactId>chess-engine-app</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Chess_Engine_App</name>

  <!--
    Builds every engine. Each engine lives in its own folder with its own pom.xml and produces a
    UCI program; the shared tools (tools/, engine.cmd, lichess bot) only talk UCI, so any engine
    can be tested or put on Lichess. Add a new engine by adding its folder here.
  -->
  <modules>
    <module>chess_engine_v1</module>
    <module>chess_engine_v2</module>
    <module>gambyte-server</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <!-- lets `mvn spotless:apply` run from this folder; each engine has its own config -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.44.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
