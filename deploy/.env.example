# Copy to deploy/.env and fill in. deploy/.env is git-ignored: secrets never go into git.

# --- Which optional containers run (remove local-db when using Neon + Upstash) ---
COMPOSE_PROFILES=local-db

# --- Site ---
# Your domain (HTTPS is automatic), or ":80" to test by IP address over plain HTTP.
SITE_ADDRESS=:80
SITE_URL=http://YOUR-IP-OR-DOMAIN
# Must be true with HTTPS (a real domain). Set false only while testing over plain http://IP.
COOKIE_SECURE=false
# Becomes ADMIN on start-up once this account is registered.
GAMBYTE_ADMIN_USERNAME=

# --- Database (local container by default) ---
DATABASE_USER=gambyte
DATABASE_PASSWORD=change-me-to-a-long-random-string
# Neon example: DATABASE_URL=jdbc:postgresql://ep-xxx.region.aws.neon.tech/gambyte?sslmode=require
# DATABASE_URL=
DATABASE_POOL_SIZE=5
# Upstash example (TLS): REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379
# REDIS_URL=

# --- Engine (1 GB machine: 1 process, 1 thread, small hash) ---
ENGINE_POOL_SIZE=1
ENGINE_THREADS=1
ENGINE_HASH_MB=16
# Mount tablebases at /syzygy (see SYZYGY_HOST_PATH) and enable:
# ENGINE_SYZYGY_PATH=/syzygy
# SYZYGY_HOST_PATH=/home/ubuntu/syzygy

# --- Email (AWS SES SMTP or any provider; empty = emails are only logged) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Gambyte <no-reply@your-domain>

# --- Payments: Razorpay (test keys first: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# --- Optional AI coach (Claude API). Empty = off. ---
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-haiku-5-5   # much cheaper than the default claude-opus-5-5

# --- Memory on a 1 GB instance ---
JAVA_OPTS=-Xmx384m -XX:+UseSerialGC
SERVER_MEM_LIMIT=640m
