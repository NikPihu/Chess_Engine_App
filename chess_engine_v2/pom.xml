<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.nikpihu</groupId>
  <artifactId>chess-engine-v2</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>chess_engine_v2</name>

  <!--
    Engine v2: chess_engine_v1's proven search + a learned NNUE evaluation, improved by a
    self-play learning loop (train/). Reuses v1's board, move generation, UCI program and board
    viewer; the jar bundles v1, so one jar holds every engine (random, v1, v2, nnue).
    Output: chess_engine_v2/target/chess_engine_v2.jar

    Layout (this folder is the Java source root):
      nnue/      the neural network: features, accumulator, inference, .nnue file loading
      search/    NnueSearch: v1's proven search with the NNUE evaluation
      datagen/   self-play data generation + Lichess game import (training data)
      engine/    V2Main: registers the "nnue" engine, then runs v1's UCI program / GUI
      train/     Python (PyTorch) trainer, exporter, generation loop
      nets/      trained networks, one file per generation
      */tests/   tests next to the code, as in v1
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.3</assertj.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.nikpihu</groupId>
      <artifactId>chess-engine-v1</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>chess_engine_v2</finalName>
    <sourceDirectory>${project.basedir}</sourceDirectory>
    <resources>
      <!-- the best network so far is packed into the jar as the default evaluation -->
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>nets/best.nnue</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <includes>
            <include>nnue/**/*.java</include>
            <include>search/**/*.java</include>
            <include>datagen/**/*.java</include>
            <include>engine/**/*.java</include>
          </includes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
          <includes>
            <include>**/tests/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <excludes>
            <exclude>**/tests/**</exclude>
          </excludes>
          <archive>
            <manifest>
              <mainClass>engine.V2Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- One runnable jar: v2's classes + all of chess_engine_v1. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>engine.V2Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.2</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <java>
            <includes>
              <include>nnue/**/*.java</include>
              <include>search/**/*.java</include>
              <include>datagen/**/*.java</include>
              <include>engine/**/*.java</include>
            </includes>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
